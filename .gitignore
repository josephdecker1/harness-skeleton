# Secrets — never commit
.env
.env.*
*-service-account.json
client_secret*.json
token_*.json
*.pem

# Agent working state (keep the structure, ignore the churn)
.claude/logs/*.local.md
.claude/memory/*.local.md

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# The review gate's one-shot off switch. The user creates it, and the gate deletes it.
.claude/review-gate.off*

# Python bytecode
__pycache__/
