# Secrets — never commit
.env
.env.*
*-service-account.json
client_secret*.json
token_*.json
*.pem

# Agent working state (keep the structure, ignore the churn)
.claude/logs/*.local.md
.claude/memory/*.local.md

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# The review gate's off switch is local to one checkout.
.claude/review-gate.off

# Python bytecode
__pycache__/
