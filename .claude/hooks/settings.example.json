{
  "_comment": "Hook wiring for a forked copy. Merge into .claude/settings.json. Skip this file if you installed the plugin, which wires the same hooks. Both hooks need to be executable.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-no-secrets.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/review-gate.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
